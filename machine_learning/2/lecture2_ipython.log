import numpy as np

def selection_sort(x):
    for i in range(len(x)):
        swap = i + np.argmin(x[i:])
        (x[i], x[swap]) = (x[swap], x[i])
    return x
    # Mon, 02 Mar 2026 16:50:13
x = np.array([2, 1, 4, 3, 5])
selection_sort(x)#[Out]# array([1, 2, 3, 4, 5])
# Mon, 02 Mar 2026 16:55:16
def bogosort(x):
    while np.any(x[:-1] > x[1:]):
        np.random.shuffle(x)
    return x
    # Mon, 02 Mar 2026 16:55:21
x = np.array([2, 1, 4, 3, 5])
bogosort(x)#[Out]# array([1, 2, 3, 4, 5])
