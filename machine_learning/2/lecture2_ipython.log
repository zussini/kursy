    diff = X[:, None, :] - C[None, :, :]
    return np.sum(diff * diff, axis=2)

# reference slow version (for tests only)
def pairwise_sq_dists_slow(X, C):
    out = np.zeros((X.shape[0], C.shape[0]), dtype=np.float64)
    for i in range(X.shape[0]):
        for k in range(C.shape[0]):
            diff = X[i] - C[k]
            out[i, k] = float(np.dot(diff, diff))
    return out

