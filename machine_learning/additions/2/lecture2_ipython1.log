import math
import numpy as np

# Ustalmy powtarzalność
RNG = np.random.default_rng(0)

def assert_allclose(a, b, tol=1e-8):
    a = np.asarray(a)
    b = np.asarray(b)
    assert a.shape == b.shape, f"Shape mismatch: {a.shape} vs {b.shape}"
    assert np.allclose(a, b, atol=tol, rtol=tol), f"Values not close (tol={tol})"

def assert_shape(x, shape):
    x = np.asarray(x)
    assert x.shape == tuple(shape), f"Expected shape {shape}, got {x.shape}"

print("NumPy version:", np.__version__)

